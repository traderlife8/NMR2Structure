#!/usr/bin/env pwsh
# ============================================================
# post-commit hook - commit 后自动 push 到 origin
# ============================================================
# 安装方法：
#   git config core.hooksPath .githooks
#
# 设计要点：
#   - 没有 origin remote → 静默跳过
#   - push 失败 → 打印警告但不返回非零（不污染 commit 状态）
#   - push 成功 → 简短提示
#   - 检测 fast-forward / non-fast-forward，分别提示
# ============================================================

$ErrorActionPreference = "Continue"

# 切到 git 仓库根目录
$RepoRoot = git rev-parse --show-toplevel 2>$null
if ([string]::IsNullOrWhiteSpace($RepoRoot)) {
    exit 0
}
Set-Location -LiteralPath $RepoRoot

# 检查 origin 是否存在
$remoteUrl = git remote get-url origin 2>$null
if ([string]::IsNullOrWhiteSpace($remoteUrl)) {
    exit 0
}

# 检测当前分支
$branch = git rev-parse --abbrev-ref HEAD 2>$null
if ([string]::IsNullOrWhiteSpace($branch) -or $branch -eq "HEAD") {
    exit 0
}

# 检测本地是否有未推送的 commit
$unpushed = git log "@{u}..$branch" --oneline 2>$null
if ([string]::IsNullOrWhiteSpace($unpushed)) {
    # 没有未推送的 commit（例如 amend 后未产生新 commit）
    exit 0
}

$count = ($unpushed | Measure-Object -Line).Lines
Write-Host "[post-commit] pushing $count new commit(s) to origin/$branch ..." -ForegroundColor Cyan

# 执行 push
$output = git push origin $branch 2>&1
$exitCode = $LASTEXITCODE

if ($exitCode -eq 0) {
    Write-Host "[post-commit] pushed OK." -ForegroundColor Green
} else {
    # 区分失败原因
    $joined = ($output | Out-String)
    if ($joined -match "non-fast-forward|rejected|fetch first") {
        Write-Host "[post-commit] push REJECTED (remote has new commits)." -ForegroundColor Yellow
        Write-Host "             run: git pull --rebase, then re-run git_sync.ps1 or push manually." -ForegroundColor Yellow
    } elseif ($joined -match "Could not resolve|Connection|timeout|unreachable") {
        Write-Host "[post-commit] push failed: network unreachable." -ForegroundColor Yellow
        Write-Host "             commit is kept locally; push later when network is back." -ForegroundColor Yellow
    } elseif ($joined -match "Authentication|denied|403|401") {
        Write-Host "[post-commit] push failed: authentication error." -ForegroundColor Yellow
        Write-Host "             check token / credentials." -ForegroundColor Yellow
    } else {
        Write-Host "[post-commit] push failed (exit=$exitCode):" -ForegroundColor Yellow
        Write-Host $joined -ForegroundColor Yellow
    }
    # 关键：失败时 exit 0，不污染 commit 状态
}

exit 0